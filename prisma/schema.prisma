// This is your Prisma schema file
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["fullTextSearch", "fullTextIndex"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums
enum Role {
  ADMIN
  MANAGER
  HR
  EMPLOYEE
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
  TEMPORARY
}

enum EmploymentStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
  TERMINATED
  SUSPENDED
}

enum LeaveType {
  VACATION
  SICK
  PERSONAL
  MATERNITY
  PATERNITY
  UNPAID
  BEREAVEMENT
  COMPENSATORY
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum DocumentType {
  CONTRACT
  RESUME
  CERTIFICATE
  ID_PROOF
  ADDRESS_PROOF
  OFFER_LETTER
  TERMINATION_LETTER
  OTHER
}

// Models
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  role      Role     @default(EMPLOYEE)
  isActive  Boolean  @default(true)
  lastLogin DateTime?

  // Relations
  employee  Employee?
  createdLeaves Leave[] @relation("LeaveCreator")
  approvedLeaves Leave[] @relation("LeaveApprover")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@map("users")
}

model Employee {
  id         String   @id @default(uuid())
  employeeId String   @unique

  // User relationship
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Personal Information
  firstName  String
  middleName String?
  lastName   String
  dateOfBirth DateTime
  gender     Gender
  phone      String
  alternatePhone String?
  personalEmail String?

  // Address Information
  address    Json     // Stored as JSON for flexibility

  // Employment Information
  department String
  position   String
  employmentType EmploymentType
  startDate  DateTime
  endDate    DateTime?

  // Reporting Structure
  managerId  String?
  manager    Employee? @relation("ManagerEmployee", fields: [managerId], references: [id])
  subordinates Employee[] @relation("ManagerEmployee")

  // Compensation
  salary     Decimal  @db.Decimal(12, 2)
  currency   String   @default("USD")

  // Status
  status     EmploymentStatus @default(ACTIVE)

  // Emergency Contact
  emergencyContact Json?

  // Additional Information
  notes      String?
  profilePicture String?

  // Relations
  leaves     Leave[]
  documents  Document[]
  attendances Attendance[]
  performanceReviews PerformanceReview[]

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([employeeId])
  @@index([userId])
  @@index([department])
  @@index([status])
  @@index([managerId])
  @@map("employees")
}

model Leave {
  id         String   @id @default(uuid())

  // Employee relationship
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  // Leave details
  leaveType  LeaveType
  startDate  DateTime
  endDate    DateTime
  days       Int
  reason     String
  status     LeaveStatus @default(PENDING)

  // Approval workflow
  requestedById String
  requestedBy   User @relation("LeaveCreator", fields: [requestedById], references: [id])

  approvedById  String?
  approvedBy    User? @relation("LeaveApprover", fields: [approvedById], references: [id])
  approvedAt    DateTime?

  rejectionReason String?

  // Additional info
  documents  String[] // Array of document URLs

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([employeeId])
  @@index([status])
  @@index([startDate, endDate])
  @@map("leaves")
}

model Attendance {
  id         String   @id @default(uuid())

  // Employee relationship
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  // Attendance details
  date       DateTime @db.Date
  checkIn    DateTime?
  checkOut   DateTime?

  // Calculated fields
  workHours  Decimal? @db.Decimal(4, 2)
  overtimeHours Decimal? @db.Decimal(4, 2)

  // Status
  isPresent  Boolean  @default(true)
  isLate     Boolean  @default(false)
  isHalfDay  Boolean  @default(false)

  // Location tracking (optional)
  checkInLocation  String?
  checkOutLocation String?

  // Notes
  notes      String?

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([employeeId, date])
  @@index([employeeId])
  @@index([date])
  @@map("attendances")
}

model PerformanceReview {
  id         String   @id @default(uuid())

  // Employee relationship
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  // Review period
  reviewPeriodStart DateTime
  reviewPeriodEnd   DateTime

  // Ratings (1-5 scale)
  technicalSkills   Int?
  communication     Int?
  teamwork          Int?
  leadership        Int?
  productivity      Int?
  initiative        Int?

  // Overall rating
  overallRating     Decimal? @db.Decimal(3, 2)

  // Feedback
  strengths         String?
  areasOfImprovement String?
  goals             String?
  managerComments   String?
  employeeComments  String?

  // Status
  isCompleted       Boolean @default(false)
  completedAt       DateTime?

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([employeeId])
  @@index([reviewPeriodStart, reviewPeriodEnd])
  @@map("performance_reviews")
}

model Document {
  id         String   @id @default(uuid())

  // Employee relationship
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  // Document details
  documentType DocumentType
  title      String
  description String?
  fileName   String
  filePath   String
  fileSize   Int
  mimeType   String

  // Metadata
  uploadedAt DateTime @default(now())
  expiryDate DateTime?

  // Document version control
  version    Int      @default(1)
  isActive   Boolean  @default(true)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([employeeId])
  @@index([documentType])
  @@map("documents")
}

model Department {
  id          String   @id @default(uuid())

  // Department details
  name        String   @unique
  code        String   @unique
  description String?

  // Head of department
  headId      String?

  // Budget
  budget      Decimal? @db.Decimal(12, 2)

  // Location
  location    String?

  // Status
  isActive    Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([name])
  @@index([code])
  @@map("departments")
}

model Position {
  id          String   @id @default(uuid())

  // Position details
  title       String   @unique
  code        String   @unique
  description String?

  // Department
  department  String

  // Salary range
  minSalary   Decimal? @db.Decimal(12, 2)
  maxSalary   Decimal? @db.Decimal(12, 2)

  // Requirements
  requirements String?

  // Status
  isActive    Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([title])
  @@index([department])
  @@map("positions")
}

model AuditLog {
  id         String   @id @default(uuid())

  // User who performed the action
  userId     String
  userEmail  String

  // Action details
  action     String   // CREATE, UPDATE, DELETE, LOGIN, LOGOUT, etc.
  entity     String   // User, Employee, Leave, etc.
  entityId   String

  // Changes
  oldValue   Json?
  newValue   Json?

  // Request details
  ipAddress  String?
  userAgent  String?

  // Timestamp
  timestamp  DateTime @default(now())

  @@index([userId])
  @@index([entity, entityId])
  @@index([timestamp])
  @@map("audit_logs")
}

model RefreshToken {
  id         String   @id @default(uuid())

  // User relationship
  userId     String

  // Token details
  token      String   @unique
  expiresAt  DateTime

  // Device information
  ipAddress  String?
  userAgent  String?

  // Status
  isRevoked  Boolean  @default(false)
  revokedAt  DateTime?

  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}
